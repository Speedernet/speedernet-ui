{
  "name": "speedernet-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build:ui": "ng build ui",
    "postbuild:ui": "node scripts/clean-dist-manifest.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:styles && ng test ui --watch=false && ng test demo --watch=false",
    "format": "prettier --write .",
    "test:styles": "node --test \"projects/ui/styles/*.test.mjs\"",
    "version-packages": "changeset version && prettier --write projects/ui/CHANGELOG.md"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@changesets/cli": "^3.0.3",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "sass": "^1.107.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "projects/ui"
  ],
  "engines": {
    "node": ">=24"
  }
}
